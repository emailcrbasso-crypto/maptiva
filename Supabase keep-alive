name: Supabase keep-alive

# O plano free do Supabase pausa o projeto após 7 dias sem atividade.
# Segunda camada, independente do cron-job.org: se o ping falhar, o
# workflow falha e o GitHub avisa por e-mail (diferente de um cron externo
# que pode se desativar em silêncio).

on:
  schedule:
    - cron: '0 9 */2 * *'
  workflow_dispatch:

permissions: {}

jobs:
  ping:
    runs-on: ubuntu-latest
    timeout-minutes: 5
    steps:
      - name: Chamar public.ping()
        env:
          SUPABASE_URL: ${{ secrets.SUPABASE_URL }}
          SUPABASE_ANON_KEY: ${{ secrets.SUPABASE_ANON_KEY }}
        run: |
          set -euo pipefail
          response=$(curl --silent --show-error --fail --max-time 30 \
            --retry 3 --retry-delay 10 --retry-all-errors \
            -X POST "$SUPABASE_URL/rest/v1/rpc/ping" \
            -H "apikey: $SUPABASE_ANON_KEY" \
            -H "Authorization: Bearer $SUPABASE_ANON_KEY" \
            -H "Content-Type: application/json" \
            -d '{}')
          echo "$response"
          echo "$response" | grep -q '"ok"'
